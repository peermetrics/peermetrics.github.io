{
  "name": "peermetrics-page",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:css": "sass static/css/main.scss static/css/main.css --no-source-map",
    "build:content": "node scripts/update-npm-downloads.mjs",
    "dev": "npm run build:css && npm run build:content && vite",
    "build": "npm run build:css && npm run build:content && npm run prepare:demo-assets && vite build",
    "preview": "vite preview",
    "prepare:demo-assets": "node scripts/prepare-demo-assets.mjs"
  },
  "dependencies": {
    "bootstrap": "^4.6.1",
    "jquery": "^3.6.0",
    "popper.js": "^1.16.1"
  },
  "devDependencies": {
    "sass": "^1.99.0",
    "vite": "^5.4.19"
  }
}
